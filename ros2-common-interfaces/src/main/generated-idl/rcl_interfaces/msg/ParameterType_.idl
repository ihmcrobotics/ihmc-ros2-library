#ifndef __rcl_interfaces__msg__ParameterType__idl__
#define __rcl_interfaces__msg__ParameterType__idl__

module rcl_interfaces
{
  module msg
  {
    module dds
    {
      /**
       * Default value, which implies this is not a valid parameter.
       */
      const octet PARAMETER_NOT_SET =
      0;

      const octet PARAMETER_BOOL =
      1;

      const octet PARAMETER_INTEGER =
      2;

      const octet PARAMETER_DOUBLE =
      3;

      const octet PARAMETER_STRING =
      4;

      const octet PARAMETER_BYTE_ARRAY =
      5;

      const octet PARAMETER_BOOL_ARRAY =
      6;

      const octet PARAMETER_INTEGER_ARRAY =
      7;

      const octet PARAMETER_DOUBLE_ARRAY =
      8;

      const octet PARAMETER_STRING_ARRAY =
      9;


      /**
       * These types correspond to the value that is set in the ParameterValue message.
       */
      @TypeCode(type="rcl_interfaces::msg::dds_::ParameterType_")
      struct ParameterType
      {
        boolean unused_placeholder_field;
      };
    };
  };
};

#endif
