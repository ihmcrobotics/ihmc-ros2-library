#ifndef __builtin_interfaces__msg__Duration__idl__
#define __builtin_interfaces__msg__Duration__idl__

module builtin_interfaces
{
  module msg
  {
    module dds
    {

      /**
       * Duration defines a period between two time points.
       * Messages of this datatype are of ROS Time following this design:
       * https://design.ros2.org/articles/clock_and_time.html
       */
      @TypeCode(type="builtin_interfaces::msg::dds_::Duration_")
      struct Duration
      {
        /**
         * The seconds component, valid over all int32 values.
         */
        long sec;
        /**
         * The nanoseconds component, valid in the range [0, 1e9), to be added to the seconds component.
         * e.g.
         * The duration -1.7 seconds is represented as {sec: -2, nanosec: 3e8}
         * The duration 1.7 seconds is represented as {sec: 1, nanosec: 7e8}
         */
        unsigned long nanosec;
      };
    };
  };
};

#endif
