#ifndef __lifecycle_msgs__msg__TransitionDescription__idl__
#define __lifecycle_msgs__msg__TransitionDescription__idl__

#include "lifecycle_msgs/msg/./State_.idl"
#include "lifecycle_msgs/msg/./Transition_.idl"
module lifecycle_msgs
{
  module msg
  {
    module dds
    {

      @TypeCode(type="lifecycle_msgs::msg::dds_::TransitionDescription_")
      struct TransitionDescription
      {
        /**
         * The transition id and label of this description.
         */
        lifecycle_msgs::msg::dds::Transition transition;
        /**
         * The current state from which this transition transitions.
         */
        lifecycle_msgs::msg::dds::State start_state;
        /**
         * The desired target state of this transition.
         */
        lifecycle_msgs::msg::dds::State goal_state;
      };
    };
  };
};

#endif
