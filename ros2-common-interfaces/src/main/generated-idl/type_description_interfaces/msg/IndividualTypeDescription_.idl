#ifndef __type_description_interfaces__msg__IndividualTypeDescription__idl__
#define __type_description_interfaces__msg__IndividualTypeDescription__idl__

#include "type_description_interfaces/msg/./Field_.idl"
module type_description_interfaces
{
  module msg
  {
    module dds
    {

      /**
       * Represents a single type, without the types it references, if any.
       */
      @TypeCode(type="type_description_interfaces::msg::dds_::IndividualTypeDescription_")
      struct IndividualTypeDescription
      {
        /**
         * Name of the type.
         * This is limited to 255 characters.
         * TODO(wjwwood): this 255 character limit was chosen due to this being the limit
         * for DDSI-RTPS based middlewares, which is the most commonly used right now.
         * We lack a ROS 2 specific limit in our design documents, but we should update
         * this and/or link to the design doc when that is available.
         */
        string<255> type_name;
        /**
         * Fields of the type.
         */
        sequence<type_description_interfaces::msg::dds::Field> fields;
      };
    };
  };
};

#endif
